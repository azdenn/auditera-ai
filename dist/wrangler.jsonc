{
  // ---------------------------------------------------------------------
  // dist config — used by local `cd dist && wrangler deploy`, and when
  // Cloudflare's build "Root directory" is "dist".
  // A SECOND config exists at the repo root (../wrangler.jsonc) for when
  // the root directory is "/". BOTH EXIST ON PURPOSE.
  // If you change one, change the other.
  // ---------------------------------------------------------------------
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "auditera",
  "main": "./_worker.js",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
