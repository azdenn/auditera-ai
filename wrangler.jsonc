{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auditera",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Load-bearing. Without this Cloudflare serves the tool files directly
    // and NEVER runs the licence gate. See licensing docs.
    "run_worker_first": ["/tools/*"]
  },
